# ==========================================
# RetentIQ Environment Configuration Template
# ==========================================

# ------------------------------------------
# Next.js Web Application (apps/web)
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VERCEL=0
NOW_BUILDER=0

# ------------------------------------------
# Express API Server (apps/api)
# ------------------------------------------
PORT=4000
API_PORT=4000
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
AI_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Encryption & Security
ENCRYPTION_KEY=your-32-byte-encryption-key-for-credentials
JWT_SECRET=your-jwt-secret-string-placeholder
CRON_SECRET=your-secure-cron-secret-token

# Integrations & Webhooks
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook_secret
INTERCOM_CLIENT_SECRET=placeholder_intercom_client_secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Email & Notifications (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@retentiq.io

# ------------------------------------------
# AI Intelligence Microservice (apps/ai-service)
# ------------------------------------------
GROQ_API_KEY=your-groq-api-key-placeholder
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PLAYBOOK_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_ROAST_MODEL=openai/gpt-oss-20b
AI_SERVICE_PORT=8000
RANDOM_SEED=42
